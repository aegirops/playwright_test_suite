{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:e2e": "nuxt dev --port 3001",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "e2e-playwright": "playwright test --project=chromium",
    "e2e-cucumber": "cucumber-js",
    "record:direct": "playwright codegen --target playwright-test --output e2e/inbox-record.spec.ts http://localhost:3000",
    "record:interactive": "playwright codegen http://localhost:3000",
    "record:viewport": "playwright codegen --target playwright-test --output e2e/inbox-record.spec.ts --viewport-size 1280,720 http://localhost:3000",
    "record:mobile": "playwright codegen --target playwright-test --output e2e/inbox-record.spec.ts --device=\"iPhone 13\" http://localhost:3000",
    "clean": "rm -rf .nuxt dist .output node_modules/.cache"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/image": "2.2.1",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@unhead/vue": "^3.4.3",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vueuse/nuxt": "^15.0.0",
    "cucumber": "^6.0.7",
    "date-fns": "^4.4.0",
    "ipx": "^4.1.0",
    "nuxt": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "resolutions": {
    "unimport": "4.1.1"
  }
}